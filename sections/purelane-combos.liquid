<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
    </div>
    
    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo_card' -%}
          <article class="glass combo{% if block.settings.is_hero_combo %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if block.settings.save_tag != blank -%}
                <span class="save">{{ block.settings.save_tag }}</span>
              {%- endif -%}
              {%- if block.settings.flag_text != blank -%}
                <span class="flag">{{ block.settings.flag_text }}</span>
              {%- endif -%}
              
              <div class="stack">
                {%- if block.settings.item_1_image_class != blank -%}
                  <span class="it">
                    <span class="pimg {{ block.settings.item_1_image_class }}" role="img" aria-label="{{ block.settings.item_1_text | escape }}"></span>
                    <span>{{ block.settings.item_1_text }}</span>
                  </span>
                {%- endif -%}
                
                {%- if block.settings.item_2_image_class != blank -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_2_image_class == 'tile' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_2_image_class }}" role="img" aria-label="{{ block.settings.item_2_text | escape }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_2_text }}</span>
                  </span>
                {%- endif -%}
                
                {%- if block.settings.item_3_image_class != blank -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_3_image_class == 'tile' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_3_image_class }}" role="img" aria-label="{{ block.settings.item_3_text | escape }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_3_text }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>
            
            <div class="body">
              <h3>{{ block.settings.title }}</h3>
              <div class="cnt">{{ block.settings.product_count }}</div>
              <p class="inc">{{ block.settings.includes_text }}</p>
              <div class="prow">
                <strong>{{ block.settings.price }}</strong>
                {%- if block.settings.compare_at_price != blank -%}
                  <s>{{ block.settings.compare_at_price }}</s>
                {%- endif -%}
                {%- if block.settings.savings_label != blank -%}
                  <em>{{ block.settings.savings_label }}</em>
                {%- endif -%}
              </div>
              <div class="fine">Inclusive of all taxes &middot; COD available</div>
              <a class="btn {% if block.settings.is_hero_combo %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
                {{ block.settings.button_text | default: 'Shop bundle' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    <p class="railnote">{{ section.settings.railnote }}</p>
  </div>
</section>


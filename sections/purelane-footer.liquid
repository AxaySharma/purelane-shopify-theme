<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="#top" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt"><span class="n1">Purelane</span><span class="n2">Clean, simply</span></span>
        </a>
        <p style="max-width:30ch">{{ section.settings.about_text }}</p>
      </div>
      <div class="fcol">
        <h5>Shop</h5>
        <a href="#shop">Bestsellers</a>
        <a href="#shop">Kitchen</a>
        <a href="#shop">Laundry</a>
        <a href="#shop">Home</a>
        <a href="#shop">Skin</a>
        <a href="#bundles">Starter kits</a>
      </div>
      <div class="fcol">
        <h5>About</h5>
        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#voices">Reviews</a>
      </div>
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        <a href="tel:{{ section.settings.phone_raw }}">{{ section.settings.phone_formatted }}</a>
        <p style="font-size:12px;color:rgba(236,230,247,.5)">{{ section.settings.company_info }}</p>
      </div>
    </div>
    <div class="fbot">
      <span>© 2026 {{ section.settings.copyright }}</span>
      <span>Privacy · Terms · Refunds · Contact</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "about_text",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one.",
      "label": "About Text"
    },
    {
      "type": "text",
      "id": "email",
      "default": "hello@purelane.com",
      "label": "Email Address"
    },
    {
      "type": "text",
      "id": "phone_raw",
      "default": "+919930123234",
      "label": "Phone Link Raw"
    },
    {
      "type": "text",
      "id": "phone_formatted",
      "default": "+91 9930 123 234",
      "label": "Phone Formatted"
    },
    {
      "type": "text",
      "id": "company_info",
      "default": "Purelane Eco Products Pvt Ltd",
      "label": "Company Info"
    },
    {
      "type": "text",
      "id": "copyright",
      "default": "Purelane Eco Products Private Limited",
      "label": "Copyright Text"
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer"
    }
  ]
}
{% endschema %}

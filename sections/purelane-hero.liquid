    {
      "type": "product",
      "id": "product_1",
      "label": "Slide 1 Product"
    },
    {
      "type": "text",
      "id": "slide_1_label",
      "default": "Single bottle",
      "label": "Slide 1 Title"
    },
    {
      "type": "text",
      "id": "slide_1_price",
      "default": "₹200",
      "label": "Slide 1 Price Override"
    },
    {
      "type": "text",
      "id": "slide_1_compare",
      "default": "₹299",
      "label": "Slide 1 Compare At Price"
    },
    {
      "type": "text",
      "id": "slide_1_discount",
      "default": "33% off",
      "label": "Slide 1 Discount Badge Text"
    },
    {
      "type": "header",
      "content": "Slide 2 Settings"
    },
    {
      "type": "product",
      "id": "product_2_1",
      "label": "Slide 2 Product 1"
    },
    {
      "type": "product",
      "id": "product_2_2",
      "label": "Slide 2 Product 2"
    },
    {
      "type": "text",
      "id": "slide_2_label",
      "default": "Any 2 products",
      "label": "Slide 2 Title"
    },
    {
      "type": "text",
      "id": "slide_2_price",
      "default": "₹349",
      "label": "Slide 2 Price Override"
    },
    {
      "type": "text",
      "id": "slide_2_compare",
      "default": "₹598",
      "label": "Slide 2 Compare At Price"
    },
    {
      "type": "text",
      "id": "slide_2_discount",
      "default": "Save ₹249",
      "label": "Slide 2 Discount Badge Text"
    },
    {
      "type": "header",
      "content": "Slide 3 Settings"
    },
    {
      "type": "product",
      "id": "product_3_1",
      "label": "Slide 3 Product 1"
    },
    {
      "type": "product",
      "id": "product_3_2",
      "label": "Slide 3 Product 2"
    },
    {
      "type": "product",
      "id": "product_3_3",
      "label": "Slide 3 Product 3"
    },
    {
      "type": "text",
      "id": "slide_3_label",
      "default": "Any 3 products",
      "label": "Slide 3 Title"
    },
    {
      "type": "text",
      "id": "slide_3_price",
      "default": "₹499",
      "label": "Slide 3 Price Override"
    },
    {
      "type": "text",
      "id": "slide_3_compare",
      "default": "₹897",
      "label": "Slide 3 Compare At Price"
    },
    {
      "type": "text",
      "id": "slide_3_discount",
      "default": "Save ₹398",
      "label": "Slide 3 Discount Badge Text"

            "badge_text": "Safe for kids & pets",
            "badge_mobile_text": "Kids & pet safe",
            "badge_icon": "shield"
          }
        },
        {
          "type": "promise_badge",
          "settings": {
            "badge_text": "Zero harsh chemicals",
            "badge_mobile_text": "Zero harsh chem",
            "badge_icon": "ban"
          }
        }

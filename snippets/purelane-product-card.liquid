{% comment %}
  Renders a Purelane custom product card matching the exact prototype.
  Accepts:
  - product: {Object} Shopify Product object (required)
{% endcomment %}

<article class="glass card rv in">
  <div class="shot">
    <span class="pill">
      {%- if product.available == false -%}Sold Out{%- elsif product.compare_at_price > product.price -%}Sale{%- else -%}Best seller{%- endif -%}
    </span>
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
    {%- else -%}
      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="color: var(--accent); opacity: 0.8; max-height: 120px;">
        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
      </svg>
    {%- endif -%}
  </div>
  
  <h4>{{ product.title }}</h4>
  
  <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
  
  <div class="pr">
    <strong>{{ product.price | money_without_trailing_zeros }}</strong>
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <em>{{ save_pct }}% off</em>
    {%- endif -%}
  </div>
  
  {%- if product.available -%}
    <form method="post" action="/cart/add" style="width: 100%;">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="btn btn-ghost btn-sm">Add to cart</button>
    </form>
  {%- else -%}
    <button class="btn btn-ghost btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">Sold Out</button>
  {%- endif -%}
</article>
